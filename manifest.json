{
  "manifest_version": 3,
  "name": "Google Play Points Weekly Prize Auto Claim",
  "version": "1.2.4",
  "description": "Automatically claims the Google Play Points weekly prize for every Google account signed in to Chrome.",
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "https://play.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Google Play Weekly Prize",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
